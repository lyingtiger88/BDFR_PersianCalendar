# Configure these as server-side secrets in the hosting provider.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ZURVAN_DESK_API_BASE_URL=https://YOUR-HTTPS-HOST
ZURVAN_DESK_ACCOUNT_DATA_ROOT=/var/lib/zurvan-desk
ZURVAN_DESK_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ZURVAN_DESK_S3_REGION=ir-thr-at1
ZURVAN_DESK_S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
ZURVAN_DESK_S3_ACCESS_KEY=REPLACE_WITH_SERVER_ONLY_ACCESS_KEY
ZURVAN_DESK_S3_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SECRET_KEY
