<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>BDFR.PersianCalendar.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyTitle>Anahita</AssemblyTitle>
    <Product>Anahita</Product>
    <Company>BDFR</Company>
    <Authors>Behdad Badfar</Authors>
    <Description>Persian calendar, planner, occasions and reminders for Windows.</Description>
    <AnahitaGitCommit Condition="'$(AnahitaGitCommit)' == ''">local</AnahitaGitCommit>
    <AnahitaBuildNumber Condition="'$(AnahitaBuildNumber)' == ''">local</AnahitaBuildNumber>
    <InformationalVersion>1.0.0+$(AnahitaGitCommit)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GitCommit" Value="$(AnahitaGitCommit)" />
    <AssemblyMetadata Include="BuildNumber" Value="$(AnahitaBuildNumber)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BDFR.PersianCalendar.Core/BDFR.PersianCalendar.Core.csproj" />
    <ProjectReference Include="../BDFR.PersianCalendar.Infrastructure/BDFR.PersianCalendar.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\picture\**\*">
      <Link>picture\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>